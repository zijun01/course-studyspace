{
  "manifest_version": 3,
  "name": "课程学习助手",
  "version": "0.8.0",
  "description": "直接读取已购买课程的音频资源，在本机转写、划选和检索。",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "https://webapp.songy.info/*",
    "https://bandu-api.songy.info/*",
    "https://bandu-resources.songy.info/*"
  ],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_title": "打开课程学习助手"},
  "web_accessible_resources": [{
    "resources": ["vendor/xterm.css"],
    "matches": ["https://webapp.songy.info/*"]
  }],
  "content_scripts": [
    {
      "matches": ["https://webapp.songy.info/*"],
      "js": ["vendor/xterm.js", "playback.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
